<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F6F4FA" android:fillViewport="true">
<LinearLayout android:orientation="vertical" android:padding="22dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="NFC Reader" android:textSize="32sp" android:textStyle="bold" android:textColor="#1D1B20" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="קורא כרטיסים אופליין • ללא אינטרנט" android:textSize="14sp" android:textColor="#706B75" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:background="@drawable/card" android:gravity="center" android:orientation="vertical" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="240dp">
<TextView android:text="NFC" android:textSize="48sp" android:textStyle="bold" android:textColor="#6750A4" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="הצמד כרטיס או תג למכשיר" android:textStyle="bold" android:textSize="20sp" android:textColor="#1D1B20" android:layout_marginTop="14dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/nfcState" android:text="ממתין לסריקה…" android:textSize="14sp" android:textColor="#79747E" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<TextView android:text="תוצאה" android:textSize="19sp" android:textStyle="bold" android:textColor="#1D1B20" android:layout_marginTop="26dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/result" android:background="@drawable/card" android:text="עדיין לא נסרק כרטיס" android:textSize="15sp" android:textColor="#49454F" android:padding="20dp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/copy" android:text="העתק תוצאה" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="52dp"/>
<Button android:id="@+id/history" android:text="היסטוריית סריקות אופליין" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="52dp"/>
<Button android:id="@+id/clearHistory" android:text="מחק היסטוריית סריקות" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="52dp"/>
<TextView android:text="הגדרות" android:textSize="19sp" android:textStyle="bold" android:textColor="#1D1B20" android:layout_marginTop="26dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Switch android:id="@+id/vibrate" android:text="רטט בסריקה" android:checked="true" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="56dp"/>
<Switch android:id="@+id/sound" android:text="צליל בסריקה" android:checked="true" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="56dp"/>
<Switch android:id="@+id/raw" android:text="הצג UID ומידע טכני" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="56dp"/>
<TextView android:text="האפליקציה אינה משתמשת באינטרנט ואינה עוקפת הצפנה או הגנות של כרטיסים." android:textSize="13sp" android:textColor="#79747E" android:layout_marginTop="18dp" android:layout_marginBottom="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>